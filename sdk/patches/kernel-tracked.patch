+}
+
+static void rkisp_l1_timeout_heartbeat(struct rkisp_stream *stream,
+				       u32 sequence)
+{
+	unsigned long flags;
+
+	if (stream->id != RKISP_STREAM_MP ||
+	    READ_ONCE(rkisp_l1_fault_drop_heartbeat))
+		return;
+
+	spin_lock_irqsave(&stream->l1_lock, flags);
+	if (stream->l1_armed &&
+	    stream->l1_timer_generation == stream->l1_generation) {
+		stream->l1_last_heartbeat_ns = rkisp_time_get_ns(stream->ispdev);
+		stream->l1_last_sequence = sequence;
+	}
+	spin_unlock_irqrestore(&stream->l1_lock, flags);
+}
+
+void rkisp_l1_timeout_start(struct rkisp_stream *stream)
+{
+	unsigned long flags;
+	unsigned int timeout_ms;
+
+	if (stream->id != RKISP_STREAM_MP || !READ_ONCE(stream->streaming))
+		return;
+
+	cancel_delayed_work_sync(&stream->l1_timeout_work);
+	spin_lock_irqsave(&stream->l1_lock, flags);
+	stream->l1_generation++;
+	stream->l1_triggered = false;
+	stream->l1_last_heartbeat_ns = rkisp_time_get_ns(stream->ispdev);
+	stream->l1_last_sequence = 0;
+	stream->l1_timer_generation = stream->l1_generation;
+	stream->l1_armed = READ_ONCE(rkisp_l1_timeout_enable);
+	spin_unlock_irqrestore(&stream->l1_lock, flags);
+
+	if (!READ_ONCE(rkisp_l1_timeout_enable))
+		return;
+
+	timeout_ms = rkisp_l1_effective_timeout_ms();
+	mod_delayed_work(system_wq, &stream->l1_timeout_work,
+			 msecs_to_jiffies(timeout_ms));
+	v4l2_info(&stream->ispdev->v4l2_dev,
+		  "L1 timeout armed: stream=%u generation=%llu timeout_ms=%u\n",
+		  stream->id, stream->l1_generation, timeout_ms);
+}
+
+void rkisp_l1_timeout_stop(struct rkisp_stream *stream)
+{
+	unsigned long flags;
+
+	if (stream->id != RKISP_STREAM_MP)
+		return;
+
+	spin_lock_irqsave(&stream->l1_lock, flags);
+	stream->l1_armed = false;
+	stream->l1_timer_generation = 0;
+	spin_unlock_irqrestore(&stream->l1_lock, flags);
+	cancel_delayed_work_sync(&stream->l1_timeout_work);
+}
