diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 98186f8b6..f771a62d9 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -1449,6 +1449,32 @@ config VIDEO_IMX415
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx415.
 
+config VIDEO_ZZH_IMX415
+	tristate "ZZH independent IMX415 fixed-mode sensor support"
+	depends on I2C && OF && GPIOLIB && COMMON_CLK && REGULATOR
+	depends on VIDEO_V4L2 && VIDEO_V4L2_SUBDEV_API && MEDIA_CONTROLLER
+	depends on MEDIA_CAMERA_SUPPORT
+	select V4L2_FWNODE
+	help
+	  Build the independent ZZH IMX415 fixed-mode sensor driver.
+
+	  The ATK-DLRK3588 stage-two validation uses this driver as a
+	  built-in driver so that it registers before Rockchip camera
+	  asynchronous notifiers complete.
+
+config VIDEO_ZZH_MLX90640
+	tristate "ZZH independent MLX90640 V4L2 Meta support"
+	depends on I2C && OF && VIDEO_V4L2 && NVMEM
+	depends on VIDEOBUF2_VMALLOC
+	depends on MEDIA_CAMERA_SUPPORT
+	help
+	  Build the independent ZZH MLX90640 thermal-array transport driver.
+
+	  The driver caches the EEPROM and emits two consecutive Chess
+	  subpages through a versioned V4L2 Meta/VB2 interface. Temperature
+	  calculation and multimodal fusion are intentionally left to
+	  userspace.
+
 config VIDEO_IMX464
 	tristate "Sony IMX464 sensor support"
 	depends on I2C && VIDEO_V4L2 && VIDEO_V4L2_SUBDEV_API
