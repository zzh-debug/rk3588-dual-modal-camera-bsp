+static void rkcif_observe_reset(struct rkcif_stream *stream)
+{
+	struct rkcif_observe_stats *observe = &stream->observe;
+	unsigned long flags;
+	u64 generation;
+
+	spin_lock_irqsave(&stream->observe_lock, flags);
+	generation = observe->generation + 1;
+	memset(observe, 0, sizeof(*observe));
+	observe->generation = generation;
+	observe->stream_start_ns = rkcif_time_get_ns(stream->cifdev);
+	spin_unlock_irqrestore(&stream->observe_lock, flags);
+}
+
+static void rkcif_observe_event(struct rkcif_stream *stream,
+				enum rkcif_observe_event event,
+				u64 timestamp_ns,
+				u32 sequence,
+				u64 irq_timestamp_ns)
+{
+	struct rkcif_observe_stats *observe = &stream->observe;
+	unsigned long flags;
+	u64 generation;
+	u64 latency_ns = 0;
+	u32 dma_mode = READ_ONCE(stream->dma_en);
+
+	if (irq_timestamp_ns && timestamp_ns >= irq_timestamp_ns)
+		latency_ns = timestamp_ns - irq_timestamp_ns;
+
+	spin_lock_irqsave(&stream->observe_lock, flags);
+	switch (event) {
+	case RKCIF_OBSERVE_FS:
+		observe->fs_count++;
+		observe->last_fs_ns = timestamp_ns;
+		break;
+	case RKCIF_OBSERVE_FE:
+		observe->fe_count++;
+		observe->last_fe_ns = timestamp_ns;
+		break;
+	case RKCIF_OBSERVE_DMA:
+		observe->dma_update_count++;
+		observe->last_dma_ns = timestamp_ns;
+		observe->last_dma_mode = dma_mode;
+		break;
+	case RKCIF_OBSERVE_VB2_DONE:
+		observe->vb2_done_count++;
+		observe->last_vb2_done_ns = timestamp_ns;
+		observe->last_irq_to_vb2_ns = latency_ns;
+		if (latency_ns &&
+		    (!observe->min_irq_to_vb2_ns ||
+		     latency_ns < observe->min_irq_to_vb2_ns))
+			observe->min_irq_to_vb2_ns = latency_ns;
+		if (latency_ns > observe->max_irq_to_vb2_ns)
+			observe->max_irq_to_vb2_ns = latency_ns;
+		break;
+	}
+	observe->last_sequence = sequence;
+	generation = observe->generation;
+	spin_unlock_irqrestore(&stream->observe_lock, flags);
+
+	trace_rkcif_stream_event(dev_name(stream->cifdev->dev),
+				 stream->id, generation, event, sequence,
+				 dma_mode, timestamp_ns, latency_ns);
+}
