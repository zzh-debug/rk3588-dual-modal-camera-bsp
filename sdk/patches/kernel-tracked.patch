+MODULE_PARM_DESC(l1_fault_drop_heartbeat,
+		 "Test only: suppress mainpath heartbeats until L1 timeout");
+
+static unsigned int rkisp_l1_effective_timeout_ms(void)
+{
+	return clamp(READ_ONCE(rkisp_l1_timeout_ms), 100U, 10000U);
+}
+
+static void rkisp_l1_timeout_work(struct work_struct *work)
+{
+	struct rkisp_stream *stream =
+		container_of(to_delayed_work(work), struct rkisp_stream,
+			     l1_timeout_work);
+	struct vb2_queue *queue = &stream->vnode.buf_queue;
+	unsigned long flags;
+	u64 now_ns = rkisp_time_get_ns(stream->ispdev);
+	u64 timeout_ns =
+		(u64)rkisp_l1_effective_timeout_ms() * NSEC_PER_MSEC;
+	u64 age_ns;
+	u64 generation;
+	u64 timeout_count;
+	u32 sequence;
+	unsigned long delay;
+
+	spin_lock_irqsave(&stream->l1_lock, flags);
+	if (!stream->l1_armed ||
+	    stream->l1_timer_generation != stream->l1_generation ||
+	    !READ_ONCE(stream->streaming) ||
+	    !READ_ONCE(rkisp_l1_timeout_enable)) {
+		stream->l1_armed = false;
+		spin_unlock_irqrestore(&stream->l1_lock, flags);
+		return;
+	}
+
+	age_ns = now_ns - stream->l1_last_heartbeat_ns;
+	if (age_ns < timeout_ns) {
+		delay = nsecs_to_jiffies(timeout_ns - age_ns);
+		spin_unlock_irqrestore(&stream->l1_lock, flags);
+		mod_delayed_work(system_wq, &stream->l1_timeout_work,
+				 max(delay, 1UL));
+		return;
+	}
+
+	stream->l1_armed = false;
+	stream->l1_triggered = true;
+	stream->l1_timeout_count++;
+	stream->l1_last_timeout_ns = now_ns;
+	generation = stream->l1_generation;
+	timeout_count = stream->l1_timeout_count;
+	sequence = stream->l1_last_sequence;
+	spin_unlock_irqrestore(&stream->l1_lock, flags);
+
+	vb2_queue_error(queue);
+	v4l2_err(&stream->ispdev->v4l2_dev,
+		 "L1 timeout: stream=%u generation=%llu age_ms=%llu sequence=%u count=%llu\n",
+		 stream->id, generation, div_u64(age_ns, NSEC_PER_MSEC),
