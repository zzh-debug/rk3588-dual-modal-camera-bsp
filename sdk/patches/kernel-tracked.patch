+module_param_named(l1_timeout_enable, rkisp_l1_timeout_enable, bool, 0644);
+MODULE_PARM_DESC(l1_timeout_enable,
+		 "Enable generation-aware L1 timeout on the RKISP mainpath");
+
+static unsigned int rkisp_l1_timeout_ms = 1000;
+module_param_named(l1_timeout_ms, rkisp_l1_timeout_ms, uint, 0644);
+MODULE_PARM_DESC(l1_timeout_ms, "RKISP mainpath L1 timeout in milliseconds");
+
