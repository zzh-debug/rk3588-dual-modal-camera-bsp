+enum rkcif_observe_event {
+	RKCIF_OBSERVE_FS = 0,
+	RKCIF_OBSERVE_FE,
+	RKCIF_OBSERVE_DMA,
+	RKCIF_OBSERVE_VB2_DONE,
+};
+
+/*
+ * Per-stream, low-overhead observability added on top of the vendor-wide
+ * irq_stats counters. Writers run from IRQ/tasklet context and readers take
+ * observe_lock before copying a snapshot for procfs.
+ */
+struct rkcif_observe_stats {
+	u64 generation;
+	u64 stream_start_ns;
+	u64 fs_count;
+	u64 fe_count;
+	u64 dma_update_count;
+	u64 vb2_done_count;
+	u64 last_fs_ns;
+	u64 last_fe_ns;
+	u64 last_dma_ns;
+	u64 last_vb2_done_ns;
+	u64 last_irq_to_vb2_ns;
+	u64 min_irq_to_vb2_ns;
+	u64 max_irq_to_vb2_ns;
+	u32 last_sequence;
+	u32 last_dma_mode;
+};
+
